{
  "name": "alia-plugin-voice-mode",
  "version": "0.1.15",
  "type": "module",
  "private": true,
  "description": "Talk to a VesnALIA thread hands-free: full-duplex, interruptible realtime voice that hands work to the thread's agent.",
  "license": "MIT",
  "engines": {
    "alia": ">=0.46",
    "aliaPluginSdk": ">=0.6.49"
  },
  "alia": {
    "name": "Voice Mode",
    "description": "Start a hands-free voice chat from an empty composer. The voice model hands work to the thread's agent and tells you when it's done; talk over it any time to interrupt.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills/voice-mode"
    ]
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "alia-plugin"
  ],
  "scripts": {
    "build": "alia plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.49"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/voice-mode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/voice-mode"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
