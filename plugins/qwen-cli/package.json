{
  "name": "alia-plugin-qwen-cli",
  "version": "0.2.4",
  "type": "module",
  "license": "MIT",
  "description": "Use the installed Qwen Code CLI as an ACP agent in VesnALIA.",
  "files": [
    "server.ts",
    "host.ts",
    "dialect.ts",
    "prompt-mode.ts",
    "workflow-policy.ts",
    "dist/*.js",
    "dist/*.meta.json",
    "!dist/*.map",
    "README.md",
    "LICENSE",
    "assets",
    "skills",
    "docs",
    "model-discovery.ts"
  ],
  "engines": {
    "alia": ">=0.48",
    "aliaPluginSdk": ">=0.6.104 <0.7",
    "node": ">=22"
  },
  "alia": {
    "name": "Qwen CLI [Experimental]",
    "description": "Chat with Qwen Code in VesnALIA using your installed CLI and existing sign-in.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "alia plugin build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test model-discovery.test.ts dialect.test.ts workflow-policy.test.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@vesnalia/plugin-sdk": "^0.6.132"
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/qwen-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/qwen-cli"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
