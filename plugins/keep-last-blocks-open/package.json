{
  "name": "alia-plugin-keep-last-blocks-open",
  "version": "0.1.2",
  "description": "Keeps the newest work blocks of a VesnALIA thread open and folds older ones. Counts are settings.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "alia": ">=0.48",
    "aliaPluginSdk": ">=0.6.109"
  },
  "alia": {
    "name": "Keep Last Blocks Open",
    "description": "Keeps the newest 5 work blocks open while a thread runs, counted at every depth. After the final answer only the last block stays open. Counts and Thought handling are settings.",
    "branding": {
      "icon": "ChevronDown"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.109"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/keep-last-blocks-open#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/keep-last-blocks-open"
  },
