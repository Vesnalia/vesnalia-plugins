{
  "name": "alia-plugin-rpiv-todo-renderer",
  "version": "0.1.2",
  "description": "Projects Pi's @juicesharp/rpiv-todo list into VesnALIA's native composer to-do panel.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "alia": ">=0.38",
    "aliaPluginSdk": ">=0.4.6"
  },
  "alia": {
    "name": "RPIV Todo",
    "description": "Shows Pi rpiv-todo tasks in VesnALIA's composer to-do list. Reconstructs the live list from todo tool calls because VesnALIA only special-cases TodoWrite and Claude Task* tools.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.6"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/rpiv-todo-renderer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/rpiv-todo-renderer"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
