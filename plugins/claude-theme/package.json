{
  "name": "alia-plugin-claude-theme",
  "version": "0.1.0",
  "description": "Give VesnALIA terracotta accents with charcoal dark and off-white light palettes, matching syntax colours, and terminal colours.",
  "type": "module",
  "license": "MIT",
  "author": "Treo-Solutions",
  "engines": {
    "aliaPluginSdk": ">=0.6.79 <0.7.0",
    "alia": ">=0.47.1 <1.0.0"
  },
  "files": [
    "server.ts",
    "dist/",
    "themes/",
    "assets/",
    "screenshots/",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "alia plugin build"
  },
  "alia": {
    "name": "Claude Theme for VesnALIA",
    "description": "Give VesnALIA terracotta accents with charcoal dark and off-white light palettes, matching syntax colours, and terminal colours.",
    "branding": {
      "icon": "./assets/claude-theme.svg"
    },
    "server": "./server.ts",
    "skills": [],
    "themes": [
      {
        "name": "Claude Theme",
        "codeTheme": {
          "dark": "./themes/claude-dark.json",
          "light": "./themes/claude-light.json"
        },
        "description": "Light and dark palettes adapted from Claude Theme for VS Code by SK.",
        "css": "./themes/claude-theme.css",
        "id": "claude-theme"
      }
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.79"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/claude-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/claude-theme"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
