{
  "name": "alia-plugin-vercel-theme",
  "version": "0.1.0",
  "description": "A crisp Vercel-inspired light and dark theme for VesnALIA with Geist typography, true-black surfaces, and matching code colors.",
  "keywords": [
    "alia",
    "alia-plugin",
    "theme",
    "vercel",
    "geist",
    "dark-mode"
  ],
  "license": "MIT",
  "author": "Divyesh Puri",
  "type": "module",
  "engines": {
    "alia": ">=0.40.0 <1.0.0",
    "aliaPluginSdk": ">=0.4.21"
  },
  "alia": {
    "name": "Vercel Theme",
    "description": "A crisp Vercel-inspired palette for VesnALIA with Geist typography, true-black dark surfaces, and matching code colors.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "themes": [
      {
        "id": "vercel",
        "name": "Vercel",
        "description": "Geist typography, monochrome surfaces, restrained blue accents, and matching light and dark code palettes.",
        "css": "./themes/vercel.css",
        "codeTheme": {
          "dark": "./themes/vercel-dark-code.json",
          "light": "./themes/vercel-light-code.json"
        }
      }
    ],
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "themes/",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server.ts"
  ],
  "scripts": {
    "build": "npm run check && alia plugin build .",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.21"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/vercel-theme#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/vercel-theme"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
