{
  "name": "alia-plugin-bb-kujo",
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "description": "A Kujo / SiteKit design-system adapter for VesnALIA.",
  "author": "Robert DeVore",
  "keywords": [
    "alia-plugin",
    "alia",
    "theme",
    "kujo",
    "sitekit"
  ],
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1",
    "alia": ">=0.49",
    "aliaPluginSdk": ">=0.6"
  },
  "alia": {
    "name": "Kujo",
    "description": "Mechanical workspace skin based on Kujo and SiteKit. Paper and ink, hard edges, quiet signal.",
    "branding": {
      "icon": "./assets/kujo-mark.svg"
    },
    "server": "./src/plugin.ts",
    "app": "./src/app.ts",
    "skills": [],
    "themes": [
      {
        "id": "kujo",
        "name": "Kujo",
        "description": "Kujo light and dark workspace with matching code, diff and terminal colors.",
        "css": "./themes/kujo.css",
        "codeTheme": {
          "dark": "./themes/kujo-code.json",
          "light": "./themes/kujo-code-light.json"
        }
      }
    ]
  },
  "files": [
    "src/",
    "themes/",
    "assets/",
    "dist/",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "docs/",
    "screenshots/",
    "scripts/",
    "tests/",
    "tsconfig.json",
    "compatibility/",
    "marketplace.json"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:generated && npm run typecheck && npm test",
    "build": "npm run generate && npm run check && alia plugin build .",
    "dev": "node scripts/dev.mjs",
    "qa": "node scripts/browser-qa.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "playwright": "1.62.1",
    "react": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.84"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/bb-kujo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/bb-kujo"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
