{
  "name": "alia-plugin-zcode-provider",
  "version": "0.2.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Run your installed ZCode agent with a Z.ai Coding Plan inside VesnALIA on macOS.",
  "engines": {
    "node": "^24.22.0 || ^26.0.0",
    "alia": ">=0.47.1",
    "aliaPluginSdk": ">=0.6.79"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "alia": {
    "name": "ZCode Provider",
    "description": "Use your Z.ai GLM Coding Plan in VesnALIA through your installed ZCode agent. macOS only.",
    "branding": {
      "icon": "./assets/zcode.svg"
    },
    "server": "./src/plugin.ts",
    "host": "./src/host.ts"
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "LICENSE",
    "NOTICE",
    "LICENSES"
  ],
  "scripts": {
    "build": "node scripts/provider/build.mjs",
    "typecheck": "node scripts/provider/build.mjs --noEmit",
    "test": "node scripts/provider/test.mjs",
    "test:artifact": "ZCODE_TEST_ARTIFACT=1 node scripts/provider/test.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "4.13.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@vesnalia/plugin-sdk": "^0.6.79"
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/zcode-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/zcode-provider"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
