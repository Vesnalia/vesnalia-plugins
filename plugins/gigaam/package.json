{
  "name": "alia-plugin-gigaam",
  "version": "0.1.3",
  "description": "Offline Russian voice input for VesnALIA, powered by GigaAM v3. Installs and runs the model on your own machine; CPU only, no API keys.",
  "license": "MIT",
  "author": "AiXenix (https://aixenix.com)",
  "keywords": [
    "alia",
    "alia-plugin",
    "gigaam",
    "speech-to-text",
    "speech-recognition",
    "asr",
    "russian",
    "voice-input",
    "dictation",
    "offline"
  ],
  "type": "module",
  "engines": {
    "alia": ">=0.46",
    "aliaPluginSdk": ">=0.6.37"
  },
  "alia": {
    "name": "GigaAM Voice Input",
    "description": "Offline Russian voice input powered by GigaAM v3. Installs and runs the model on your own machine; CPU only, no API keys.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts"
  },
  "scripts": {
    "embed": "node scripts/embed-python.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "alia plugin build"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.37"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/gigaam#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/gigaam"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
