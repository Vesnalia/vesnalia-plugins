{
  "name": "alia-plugin-radar",
  "version": "0.5.4",
  "type": "module",
  "private": true,
  "description": "Live queues of the PRs and issues that need you on GitHub and Delta (plus optional read-only Gitstream history), with one-click review threads.",
  "scripts": {
    "build": "alia plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "alia": ">=0.46",
    "aliaPluginSdk": ">=0.6.37"
  },
  "alia": {
    "name": "Radar",
