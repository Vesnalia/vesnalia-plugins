{
  "name": "alia-plugin-drmanhattan",
  "version": "0.10.1",
  "type": "module",
  "description": "Shows each VesnALIA thread's drmanhattan runs and tells VesnALIA's agents to queue heavy commands through drmanhattan.",
  "license": "MIT",
  "keywords": [
    "alia-plugin"
  ],
  "engines": {
    "alia": ">=0.49",
    "aliaPluginSdk": ">=0.6.132"
  },
  "alia": {
    "name": "drmanhattan",
    "description": "Makes agents in parallel threads take turns on builds and tests, and shows each thread its queued runs.",
    "branding": {
      "icon": "./icons/atom.svg",
      "experimental_icons": {
        "atom": "./icons/atom.svg"
      }
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "alia plugin build"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "@vesnalia/plugin-sdk": "^0.6.132"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/drmanhattan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/drmanhattan"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
