{
  "name": "alia-plugin-syns",
  "version": "0.12.4",
  "type": "module",
  "private": true,
  "engines": {
    "alia": ">=0.43",
    "aliaPluginSdk": ">=0.4.104"
  },
  "alia": {
    "name": "Syns",
    "description": "Gives Thread Pages read and write access to the calling session's Syns repository, through the Syns CLI on that session's machine.",
    "branding": {
      "icon": "GitBranch"
    },
    "server": "./server.ts",
    "host": "./host.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "alia plugin build && npm run build:claude",
    "build:claude": "rolldown hosts/claude/main.ts --platform node --format esm --file hosts/claude/bin/syns-pages.mjs"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rolldown": "1.2.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "license": "MIT",
  "description": "A VesnALIA plugin that gives Thread Pages read and write access to the session's Syns repository, through the Syns CLI.",
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.104"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/syns#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/syns"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
