{
  "name": "alia-plugin-nanogpt-provider",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Oleksander Trybushnyi",
  "description": "Use NanoGPT's models in VesnALIA threads: paste an API key and the live model catalog appears.",
  "engines": {
    "alia": ">=0.49",
    "aliaPluginSdk": ">=0.6.133"
  },
  "alia": {
    "name": "NanoGPT provider",
    "description": "Use NanoGPT's models in VesnALIA threads: paste an API key and the live model catalog appears.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ],
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "nano-gpt",
        "displayName": "NanoGPT"
      }
    ]
  },
  "keywords": [
    "alia-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "alia plugin build .",
    "install:bb": "alia plugin install . --yes",
    "dev": "alia plugin dev ."
  },
  "dependencies": {
    "zod": "^4.6.7",
    "@vesnalia/plugin-sdk": "^0.6.133"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.4",
    "hono": "^4.13.16",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/nanogpt-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/nanogpt-provider"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
