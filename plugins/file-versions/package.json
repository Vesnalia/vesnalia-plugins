{
  "name": "alia-plugin-file-versions",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "alia": ">=0.44",
    "aliaPluginSdk": ">=0.5.29"
  },
  "alia": {
    "name": "File Versions",
    "description": "See which copy of a deck, document or spreadsheet is the latest across all your projects. Groups v2, final, dated and (1) copies of one document, in English and Russian. Copies in archive folders never count as the latest ahead of a current one. Agents get the same answer from VesnALIA file-versions list, so they work from the right file. Reads project folders on the VesnALIA server and never changes a file.",
    "branding": {
      "icon": "./icons/logo.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "description": "See which copy of a deck, document or spreadsheet is the latest across all your projects.",
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
