{
  "name": "alia-plugin-xberg",
  "version": "0.1.3",
  "description": "Extract text from PDFs, Office files and images in VesnALIA threads with Xberg.",
  "type": "module",
  "license": "MIT",
  "author": "vidurb",
  "engines": {
    "alia": ">=0.48",
    "aliaPluginSdk": ">=0.6.104"
  },
  "alia": {
    "name": "Xberg",
    "description": "Lets agents read PDFs, Office files, images and other documents with Xberg, running on the machine that holds the thread's workspace.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "alia plugin build .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "zod": "^4.6.5",
    "@vesnalia/plugin-sdk": "^0.6.104"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/xberg#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/xberg"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
