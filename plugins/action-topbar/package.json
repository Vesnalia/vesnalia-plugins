{
  "name": "alia-plugin-action-topbar",
  "version": "0.1.5",
  "description": "A compact main-thread topbar for VesnALIA panel tabs and draggable Actions.",
  "license": "MIT",
  "author": "Mateo Cerquetella",
  "keywords": [
    "alia",
    "alia-plugin",
    "actions",
    "tabs",
    "topbar",
    "split-pane"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "alia": ">=0.40",
    "aliaPluginSdk": ">=0.4.33"
  },
  "alia": {
    "name": "Action Topbar",
    "description": "Mirror open thread-panel tabs in a compact topbar with a searchable + launcher.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "assets/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server.ts",
    "app.tsx",
    "app.css",
    "lib/"
  ],
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.0",
    "vaul": "^1.1.2"
  },
  "scripts": {
    "dev": "bun ../../scripts/dev-plugin.ts",
    "build": "env -u ALIA_CLI alia plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.21"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/action-topbar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/action-topbar"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
