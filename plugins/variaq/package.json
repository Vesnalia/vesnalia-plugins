{
  "name": "alia-plugin-variaq",
  "version": "0.6.1",
  "type": "module",
  "description": "Thin VesnALIA adapter for the standalone VariaQ hybrid-compute research platform.",
  "license": "Apache-2.0",
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "lib/",
    "server.ts",
    "skills/",
    "scripts/smoke.sh",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "alia": ">=0.49",
    "aliaPluginSdk": ">=0.6"
  },
  "alia": {
    "name": "VariaQ",
    "description": "Run VariaQ classical/quantum experiments from VesnALIA against a standalone VariaQ install.",
    "branding": {
      "icon": "Zap"
    },
    "server": "./server.ts",
    "skills": [
      "skills"
    ]
  },
  "overrides": {
    "bb-app": {
      "npm": "11.19.1"
    },
    "source-map-js": "1.2.2"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.1",
    "hono": "^4.13.8",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "alia plugin build",
    "sdk:check": "alia plugin types --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/runner.test.ts tests/fake.test.ts",
    "test:integration": "vitest run tests/server.test.ts",
    "smoke": "bash scripts/smoke.sh"
