{
  "name": "alia-plugin-trace-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Bring indexed code, project decisions, and context usage into VesnALIA threads",
  "engines": {
    "node": ">=22.19.0",
    "alia": ">=0.45.0",
    "aliaPluginSdk": ">=0.6.33"
  },
  "alia": {
    "name": "trace-mcp",
    "description": "Find code and project decisions from VesnALIA threads. A thread panel shows index health, saved decisions, and the provider's context-window usage; native tools and VesnALIA trace commands work on each environment's machine.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "alia-plugin",
    "memory",
    "context",
    "tokens",
    "mcp"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:smoke": "node smoke.mjs",
    "test:plugin": "node --import tsx verify-plugin.mjs",
    "test:app": "vitest run --config vitest.config.ts"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.33"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/trace-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/trace-mcp"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
