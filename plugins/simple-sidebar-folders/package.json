  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.104",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0"
  }
