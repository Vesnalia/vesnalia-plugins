{
  "name": "alia-plugin-simple-sidebar-folders",
  "version": "0.1.0",
  "type": "module",
  "description": "Group VesnALIA sidebar projects into collapsible folders without replacing the thread list.",
  "license": "MIT",
  "keywords": [
    "alia",
    "alia-plugin",
    "sidebar",
    "folders",
    "projects"
  ],
  "engines": {
    "alia": ">=0.43",
    "aliaPluginSdk": ">=0.4.104"
  },
  "alia": {
    "name": "Simple Sidebar Folders",
    "description": "Adds one folder level above sidebar projects, so a whole group of projects folds with one click. VesnALIA's own project and thread rows stay as they are.",
    "branding": {
      "icon": "Folder"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.104"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/simple-sidebar-folders#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/simple-sidebar-folders"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
