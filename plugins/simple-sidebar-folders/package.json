{
  "name": "bb-plugin-simple-sidebar-folders",
  "version": "0.1.0",
  "type": "module",
  "description": "Group BB sidebar projects into collapsible folders without replacing the thread list.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chug2k/bb-plugin-simple-sidebar-folders.git"
  },
  "homepage": "https://github.com/chug2k/bb-plugin-simple-sidebar-folders#readme",
  "bugs": {
    "url": "https://github.com/chug2k/bb-plugin-simple-sidebar-folders/issues"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "sidebar",
    "folders",
    "projects"
  ],
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.104"
  },
  "bb": {
    "name": "Simple Sidebar Folders",
