{
  "name": "@smsunarto/alia-plugin-monokai",
  "version": "0.3.2",
  "description": "A dark Monokai-family palette for VesnALIA: one meaning per hue, a single text ladder, and a matching terminal.",
  "keywords": [
    "alia",
    "alia-plugin",
    "theme",
    "palette",
    "monokai",
    "dark-mode"
  ],
  "license": "MIT",
  "author": "Scott Sunarto",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "alia": ">=0.40.0 <1.0.0",
    "aliaPluginSdk": ">=0.4.21"
  },
  "alia": {
    "name": "VesnALIA Monokai",
    "description": "A dark Monokai-family palette for VesnALIA: one meaning per hue, a single text ladder, and a matching terminal.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server.ts",
    "themes": [
      {
        "id": "alia-monokai",
        "name": "VesnALIA Monokai",
        "description": "Dark-only Monokai-family palette: one meaning per hue, a single text ladder, the shared ANSI content palette, and a monospace-first type stack.",
        "css": "./themes/alia-monokai.css",
        "codeTheme": {
          "dark": "./themes/alia-monokai-code.json"
        }
      }
    ],
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "themes/",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server.ts"
  ],
  "devDependencies": {
    "@storybook/react-vite": "10.5.7",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.7",
    "typescript": "^7.0.0",
    "vite": "^8.2.1",
    "zod": "^4.3.6"
  },
  "scripts": {
    "dev": "bun ../../scripts/dev-plugin.ts",
    "storybook": "storybook dev --port 6006",
    "generate:theme": "bun run scripts/generate-theme.ts",
    "sync:code-theme": "bun run scripts/sync-code-theme.ts",
    "check:theme": "bun run scripts/generate-theme.ts --check",
    "check": "bun run typecheck && bun run check:theme",
    "build": "bun run check && alia plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.21"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/monokai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/monokai"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
