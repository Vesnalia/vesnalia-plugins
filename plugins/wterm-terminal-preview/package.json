{
  "name": "alia-plugin-wterm-terminal-preview",
  "version": "0.3.18",
  "description": "Ghostty-backed, thread-scoped terminal for VesnALIA with file upload and font controls.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "alia plugin build && cp ghostty-vt.wasm SymbolsNerdFontMono-Regular.woff2 dist/",
    "test": "vitest run --config vitest.config.ts"
  },
  "engines": {
    "alia": ">=0.35.1",
    "aliaPluginSdk": ">=0.6"
  },
  "alia": {
    "name": "Wterm Terminal Preview",
    "description": "Use a Ghostty-backed terminal attached to the current VesnALIA thread.",
    "branding": {
      "icon": "Terminal"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@wterm/dom": "^0.4.0",
    "@wterm/ghostty": "^0.4.0",
    "@wterm/react": "^0.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.21"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/wterm-terminal-preview#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/wterm-terminal-preview"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
