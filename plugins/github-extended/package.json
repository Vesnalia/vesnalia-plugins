{
  "name": "alia-plugin-github-extended",
  "version": "0.1.3",
  "description": "Browse GitHub issues, pull requests, and Dependabot alerts, and automate GitHub workflows in VesnALIA.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "alia": ">=0.0",
    "aliaPluginSdk": ">=0.6.49"
  },
  "alia": {
    "name": "GitHub Extended",
    "description": "Browse GitHub issues, pull requests, and Dependabot alerts, and automate GitHub workflows in VesnALIA.",
    "branding": {
      "icon": "Github"
    },
    "server": "./src/server.ts",
    "app": "./src/app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && alia plugin build",
    "typecheck": "tsc6 --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "check:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build && npm run check:package"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "skills",
    "styles.css",
    "README.md",
    "docs",
    "PLUGIN_OVERVIEW.md",
    "CHANGELOG.md",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "keywords": [
    "alia-plugin",
    "github",
    "dependabot",
    "automation",
    "pull-requests"
  ],
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.49"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/github-extended#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/github-extended"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
