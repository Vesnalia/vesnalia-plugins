{
  "name": "alia-plugin-nudger",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "description": "Agents stop halfway and wait for you to type “go on”. Nudger types it for you: Jev reads each stopped thread and nudges only unfinished work, never past a blocker or a request for permission.",
  "type": "module",
  "exports": {
    "./contract": "./nudger-contract.ts"
  },
  "engines": {
    "alia": ">=0.46",
    "aliaPluginSdk": ">=0.6.39"
  },
  "alia": {
    "name": "Nudger",
    "description": "Agents stop halfway and wait for you to type “go on”. Nudger types it for you: Jev reads each stopped thread and nudges only unfinished work, never past a blocker or a request for permission.",
    "branding": {
      "icon": "./hand.svg",
      "experimental_icons": {
        "hand": "./hand.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills/nudger"
    ]
  },
  "files": [
    "dist",
    "!dist/*.map",
    "*.ts",
    "*.tsx",
    "*.css",
    "!*.test.ts",
    "skills/",
    "hand.svg",
    "tsconfig.json",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "lucide-LICENSE.txt"
  ],
  "scripts": {
    "build": "alia plugin build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test *.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.39"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/nudger#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/nudger"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
