# EXAMPLE settings for alia-box's Proxmox LXC host scripts. Copy it to
# /etc/alia-box/alia-box.env on the Proxmox host and change what differs on yours.
# Every script in host/ and template/ reads this file; the values below are
# the defaults each script uses when a setting is missing.

# Proxmox
ALIABOX_NODE=                      # default: this host's node name (hostname)
ALIABOX_POOL=aliabox                 # resource pool holding templates and boxes
ALIABOX_STORAGE=local-lvm          # needs linked clones: LVM-thin, ZFS or Ceph RBD
ALIABOX_OS_TEMPLATE=local:vztmpl/ubuntu-24.04-standard_24.04-2_amd64.tar.zst
# The Wayland desktop's base (build.sh desktop --wayland): Ubuntu 26.04, whose
# Sway and wayvnc carry the box's own pointer shapes. The X11 desktops and
# Linux stay on ALIABOX_OS_TEMPLATE.
ALIABOX_OS_TEMPLATE_WAYLAND=local:vztmpl/ubuntu-26.04-standard_26.04-1_amd64.tar.zst
ALIABOX_BUILD_VMID=                # build.sh --replace builds here; default: the next free VMID
ALIABOX_GPU_REPORT_VMID=           # setup-gpu-report.sh's VM: required, outside alia-box's VMID range

# Box network: a bridge with no physical port, routed and masqueraded by the host.
ALIABOX_BRIDGE=vmbr200
ALIABOX_GATEWAY_CIDR=10.200.0.1/24 # the host's address on the bridge, and the subnet
ALIABOX_BUILD_ADDRESS=10.200.0.2   # used by template builds only
ALIABOX_DNS="1.1.1.1 9.9.9.9"      # resolvers baked into the templates

# Optional DNAT rules for boxes, space separated, each ADDRESS:PORT=TARGET.
# Use this when a name boxes need (such as your ALIA server's) resolves to an
# address that only answers traffic from elsewhere, for example the host's own
# VPN address with a port forward that only matches VPN traffic.
ALIABOX_DNAT=

# ALIA server. When set, template builds pre-install its alia-app package for the
# box user, so enrolling a box as a ALIA machine skips that download.
ALIABOX_ALIA_URL=                    # for example https://bb.example.com
ALIABOX_ALIA_RESOLVE=                # optional curl --resolve for the host, HOST:443:ADDRESS

# The plugin's SSH key pair; created if missing. Its public key goes into the
# templates for the box user and root.
ALIABOX_SSH_KEY=/root/alia-box/ssh/id_ed25519

# The plugin's Proxmox identity (setup-token.sh).
ALIABOX_API_USER=aliabox@pve
ALIABOX_API_TOKEN=plugin
ALIABOX_API_ROLE=AliaBoxPlugin
ALIABOX_TOKEN_FILE=/root/alia-box/proxmox-token.env
