{
  "name": "alia-plugin-pulse",
  "version": "0.1.23",
  "type": "module",
  "private": true,
  "description": "A live board of what needs you from Slack, Gmail and Calendar, kept current by scheduled VesnALIA agent runs.",
  "license": "MIT",
  "bin": {
    "pulse": "./bin/pulse.mjs"
  },
  "scripts": {
    "build": "alia plugin build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs && node --experimental-strip-types --import ./test/resolve-ts.mjs --test test/*.test.ts"
  },
  "engines": {
    "alia": ">=0.46",
    "aliaPluginSdk": ">=0.6.37"
  },
  "alia": {
    "name": "Pulse",
    "description": "One live board of what needs you from Slack, Gmail and Calendar. Scheduled agent runs write the items; Done and Snooze stick; quick actions copy a prepared reply; the robot hands an item to an agent thread.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.37"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/pulse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/pulse"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
