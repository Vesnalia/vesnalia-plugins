{
  "name": "alia-plugin-steel-browser",
  "version": "0.2.0",
  "private": true,
  "description": "Run and manage self-hosted Steel browser sessions from VesnALIA.",
  "type": "module",
  "license": "MIT",
  "author": "Mateo Cerquetella",
  "keywords": [
    "alia",
    "alia-plugin",
    "steel",
    "browser",
    "browser-automation"
  ],
  "engines": {
    "alia": ">=0.40",
    "aliaPluginSdk": ">=0.4.21"
  },
  "alia": {
    "name": "VesnALIA Surf",
    "description": "Operate self-hosted Steel browser sessions from VesnALIA.",
    "branding": {
      "icon": "./assets/nav-icon.svg",
      "logo": {
        "light": "./assets/icon.svg",
        "dark": "./assets/icon.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills/steel-browser"
    ]
  },
  "files": [
    "dist/",
    "assets/",
    "skills/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "app.tsx",
    "app.css",
    "contract.ts",
    "server.ts",
    "steel-client.ts",
    "projects.ts",
    "rpc-timeout.ts",
    "use-follow-viewer.ts",
    "use-panel-expansion.ts",
    "engines.ts",
    "jev-runtime.ts",
    "actions.ts",
    "navigation.ts",
    "viewer-protocol.ts",
    "live-viewer.tsx",
    "service-catalog.ts",
    "sign-ins.ts",
    "sign-ins-panel.tsx",
    "dashboard-cache.ts",
    "provisioning.ts",
    "scripts/"
  ],
  "dependencies": {
    "playwright": "1.63.0",
    "lucide-react": "^1.49.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.0",
    "vaul": "^1.1.2"
  },
  "scripts": {
    "build": "env -u ALIA_CLI alia plugin build .",
    "dev": "alia plugin dev .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u ALIA_CLI alia plugin types --check .",
    "types:refresh": "env -u ALIA_CLI alia plugin types .",
    "test": "node --test --experimental-transform-types test/*.test.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.21"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/steel-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/steel-browser"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
