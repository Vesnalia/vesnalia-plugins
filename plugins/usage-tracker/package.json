{
  "name": "alia-plugin-usage-tracker",
  "version": "0.1.17",
  "private": true,
  "description": "Compact Codex, Claude, Cursor, Grok, OpenCode, Antigravity, and DeepSeek usage in VesnALIA's sidebar footer.",
  "license": "MIT",
  "author": "Mateo Cerquetella",
  "keywords": [
    "alia",
    "alia-plugin",
    "agents",
    "usage",
    "quota",
    "codex",
    "claude-code",
    "cursor",
    "grok",
    "opencode",
    "antigravity",
    "deepseek"
  ],
  "type": "module",
  "engines": {
    "alia": ">=0.38",
    "aliaPluginSdk": ">=0.4.6"
  },
  "alia": {
    "name": "Usage Tracker",
    "description": "Compact Codex, Claude, Cursor, Grok, OpenCode, Antigravity, and DeepSeek usage in the sidebar footer.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": []
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "env -u ALIA_CLI alia plugin build .",
    "dev": "alia plugin dev .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u ALIA_CLI alia plugin types --check .",
    "types:refresh": "env -u ALIA_CLI alia plugin types .",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "verify:focused": "npm run typecheck && npm test && npm run build",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.94"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/usage-tracker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/usage-tracker"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
