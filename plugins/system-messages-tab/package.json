{
  "name": "alia-plugin-system-messages-tab",
  "version": "0.2.0",
  "type": "module",
  "description": "Moves [VesnALIA system] notices and messages from other threads out of \"Your messages\" into their own tab, dates every outline entry, and lists entries newest first.",
  "license": "MIT",
  "keywords": [
    "alia-plugin",
    "chat",
    "navigation"
  ],
  "engines": {
    "alia": ">=0.48",
    "aliaPluginSdk": ">=0.6.94"
  },
  "alia": {
    "name": "System Messages Tab",
    "description": "Moves [VesnALIA system] notices and messages from other threads out of \"Your messages\" into their own tab, dates every outline entry, and lists entries newest first.",
    "branding": {
      "icon": "Bell"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "alia plugin build . && node scripts/strip-map-paths.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  },
  "author": "FlowGoCrazy",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.94"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/system-messages-tab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/system-messages-tab"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
