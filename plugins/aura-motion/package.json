{
  "name": "alia-plugin-aura-motion",
  "version": "0.3.4",
  "description": "Video, animated GIF and photo wallpapers with selectable dither textures for VesnALIA. Based on Aura by Mateo Cerquetella.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "alia": ">=0.40",
    "aliaPluginSdk": ">=0.4.21",
    "node": ">=22.19.0"
  },
  "alia": {
    "name": "Aura Motion",
    "description": "Video, animated GIF and photo wallpapers behind your chats with Apple-style glass, seven dither patterns, six saved slots, and an optional activity overview.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "files": [
    "dist/",
    "assets/",
    "lib/",
    "server.ts",
    "app.tsx",
    "app.css",
    "README.md",
    "LICENSE",
    "licenses/",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "env -u ALIA_CLI alia plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:responsive": "node test/responsive.browser.mjs"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.2",
    "hono": "^4.13.13",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "author": "Nikos Benakis",
  "contributors": [
    "Mateo Cerquetella (original Aura plugin)"
  ],
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.29"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/aura-motion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/aura-motion"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
