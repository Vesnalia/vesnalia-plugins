{
  "name": "bb-plugin-tokyo-night",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": ">=0.4.8"
  },
  "bb": {
    "name": "Tokyo Night",
    "description": "Tokyo Night palettes for bb \u2014 Night and Storm, each pairing its dark base with Tokyo Night Light for light mode.",
    "branding": {
      "icon": "./icon.svg"
    },
    "server": "./server.ts",
    "themes": [
      {
        "id": "tokyo-night",
        "name": "Tokyo Night",
        "description": "The original \u2014 deep indigo base (#1a1b26).",
        "css": "./themes/tokyo-night.css"
      },
      {
        "id": "tokyo-night-storm",
        "name": "Tokyo Night Storm",
        "description": "Lighter, bluer base (#24283b); identical accents.",
        "css": "./themes/tokyo-night-storm.css"
      }
    ]
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0"
  }
}
