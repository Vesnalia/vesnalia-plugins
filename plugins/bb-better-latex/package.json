    "name": "Better LaTeX",
    "description": "Renders $...$ and leftover \\[...\\] / \\(...\\) math in chat. Stock VesnALIA only ships $$...$$; this plugin adds currency-safe heuristics and reassembles formulas markdown splits across nodes.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "generate:katex-css": "node scripts/generate-katex-shadow-css.mjs",
    "prepare": "npm run generate:katex-css"
  },
  "dependencies": {
    "katex": "^0.16.27"
  },
  "devDependencies": {
