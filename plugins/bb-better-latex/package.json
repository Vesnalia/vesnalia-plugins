{
  "name": "alia-plugin-bb-better-latex",
  "version": "0.2.8",
  "description": "Better inline and display LaTeX for VesnALIA chat. Renders $...$, leftover \\[...\\] / \\(...\\), and currency-safe heuristics.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "alia": ">=0.38",
    "aliaPluginSdk": ">=0.4.6"
  },
