{
  "name": "alia-plugin-vesper",
  "version": "1.0.0",
  "description": "Rauno Freiberg's Vesper colors for VesnALIA, as dark, light and auto palettes with matching code colors.",
  "type": "module",
  "license": "MIT",
  "files": [
    "assets/icon.svg",
    "src/server.ts",
    "themes",
    "skills"
  ],
  "engines": {
    "alia": ">=0.46",
    "aliaPluginSdk": ">=0.6.37"
  },
  "scripts": {
    "build": "alia plugin build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "alia": {
    "name": "Vesper",
    "description": "Rauno Freiberg's Vesper colors for VesnALIA, as dark, light and auto palettes with matching code colors.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./src/server.ts",
    "skills": [
      "skills"
    ],
    "themes": [
      {
        "id": "vesper",
        "name": "Vesper",
        "description": "Peppermint and orange. Follows the app's light/dark mode.",
        "css": "./themes/vesper.css",
        "codeTheme": {
          "dark": "./themes/vesper-code-dark.json",
          "light": "./themes/vesper-code-light.json"
        }
      },
      {
        "id": "vesper-dark",
        "name": "Vesper Dark",
        "description": "Vesper's dark palette, always dark.",
        "css": "./themes/vesper-dark.css",
        "codeTheme": {
          "dark": "./themes/vesper-code-dark.json",
          "light": "./themes/vesper-code-dark.json"
        }
      },
      {
        "id": "vesper-light",
        "name": "Vesper Light",
        "description": "Paper-white inversion of the same three hues, always light.",
        "css": "./themes/vesper-light.css",
        "codeTheme": {
          "dark": "./themes/vesper-code-light.json",
          "light": "./themes/vesper-code-light.json"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.37"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/vesper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/vesper"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
