{
  "name": "alia-plugin-otel",
  "version": "0.1.1",
  "description": "Export OpenTelemetry (OTLP/HTTP) from VesnALIA: turn spans, GenAI token and cost metrics, thread links and provider usage windows. Never exports prompt, response or tool text.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "alia-plugin",
    "opentelemetry",
    "otlp",
    "observability",
    "genai"
  ],
  "engines": {
    "alia": ">=0.46",
    "aliaPluginSdk": ">=0.6.49"
  },
  "alia": {
    "name": "OpenTelemetry",
    "description": "Export per-turn spans, GenAI token and cost metrics and provider usage windows over OTLP/HTTP. Never exports prompt, response or tool text.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "alia plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.68"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/otel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/otel"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
