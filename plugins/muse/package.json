{
  "name": "alia-plugin-muse",
  "version": "0.3.22",
  "description": "Muse as a VesnALIA provider: drive the Muse web app from a persistent Chrome profile.",
  "license": "Apache-2.0",
  "author": "Kirill Vechkasov",
  "type": "module",
  "bin": {
    "musebridge": "bin/musebridge.mjs",
    "muse-acp": "bin/muse-acp.mjs"
  },
  "scripts": {
    "auto-login": "node scripts/auto-login.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22",
    "alia": ">=0.46",
    "aliaPluginSdk": ">=0.6.49"
  },
  "alia": {
    "name": "Muse",
    "description": "Run VesnALIA chats on Muse (muse.ai) through a signed-in Chrome profile.",
    "branding": {
      "icon": "./icons/muse.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "playwright-core": "^1.56.1",
    "ws": "^8.22.1",
    "zod": "^4.6.5",
    "@vesnalia/plugin-sdk": "^0.6.49"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/muse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/muse"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
