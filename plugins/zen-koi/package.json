{
  "name": "alia-plugin-zen-koi",
  "version": "0.6.3",
  "private": true,
  "description": "A quiet pixel-art koi pond above the chat input while the thread's agent works.",
  "keywords": [
    "alia-plugin",
    "koi",
    "zen",
    "pixel-art",
    "calm"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "koi.ts",
    "scene.ts",
    "composer-dom.ts",
    "composer-water.ts",
    "config.ts",
    "sukui.ts",
    "sound.ts",
    "world.ts",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "alia plugin build",
    "test": "node --experimental-strip-types --no-warnings --test koi.test.ts sukui.test.ts server.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "alia": ">=0.46",
    "aliaPluginSdk": ">=0.6.37"
  },
  "alia": {
    "name": "Zen Koi",
    "description": "A quiet pixel-art koi pond above the chat input while the thread's agent works.",
    "branding": {
      "icon": "./assets/koi.svg",
      "experimental_icons": {
        "koi": "./assets/koi.svg",
        "sound": "./assets/sound.svg",
        "expand": "./assets/expand.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.37"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/zen-koi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/zen-koi"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
