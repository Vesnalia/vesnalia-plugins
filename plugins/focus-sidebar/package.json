{
  "name": "alia-plugin-focus-sidebar",
  "version": "0.1.5",
  "type": "module",
  "engines": {
    "alia": ">=0.47",
    "aliaPluginSdk": ">=0.6.79"
  },
  "alia": {
    "name": "Focus Sidebar",
    "description": "Keep only the threads from the last few hours in your sidebar. Older ones move to a dated Archive; search and close are one click away.",
    "branding": {
      "icon": "Target"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "description": "Focus on today's VesnALIA threads: recent ones up top, older ones in a dated Archive, with search and a close button.",
  "keywords": [
    "alia-plugin",
    "alia",
    "sidebar",
    "threads",
    "focus",
    "archive",
    "search"
  ],
