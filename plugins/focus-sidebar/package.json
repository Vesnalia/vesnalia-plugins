  "author": "Grigory Shimichev",
  "scripts": {
    "build": "alia plugin build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.79"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/focus-sidebar#readme",
