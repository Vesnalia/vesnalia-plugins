  "description": "Bring Steph Ango's Flexoki ink-and-paper palette to VesnALIA: light and dark UI, matching syntax and terminal colours.",
  "type": "module",
  "license": "MIT",
  "author": "ponomr",
  "engines": {
    "aliaPluginSdk": ">=0.6.79 <0.7.0",
