  },
  "files": [
    "server.ts",
    "dist/",
    "themes/",
    "assets/",
    "screenshots/",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
