{
  "name": "bb-plugin-live-markdown",
  "version": "0.1.0",
  "description": "Live-preview Markdown editing in bb's side panel, with saves that change only the text you typed.",
  "license": "MIT",
  "author": "bottlebrushes",
  "homepage": "https://github.com/bottlebrushes/bb-plugin-live-markdown#readme",
  "bugs": {
    "url": "https://github.com/bottlebrushes/bb-plugin-live-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bottlebrushes/bb-plugin-live-markdown.git"
  },
  "keywords": [
    "bb-plugin",
    "markdown",
    "editor"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "env -u BB_CLI bb plugin build .",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "check": "npm run types:check && npm run typecheck && npm run build"
  },
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.5.9"
  },
  "bb": {
    "name": "Live Markdown",
    "description": "Edit Markdown in place with live preview: formatting renders as you type, tables stay editable tables, and saves change only the text you typed.",
    "branding": {
      "icon": "FileText"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.9",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
}
