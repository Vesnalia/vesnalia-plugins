    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "assets/",
    "companion/",
    "native/",
    "README.md",
    "LICENSE",
    "server.ts",
    "lib/"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "tsx": "^4.23.12",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "build": "env -u ALIA_CLI alia plugin build .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u ALIA_CLI alia plugin types --check .",
