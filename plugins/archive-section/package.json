{
  "name": "alia-plugin-archive-section",
  "version": "0.1.0",
  "description": "Moves every thread you archive into an Archived sidebar section, and back out when you unarchive it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "alia": ">=0.47",
    "aliaPluginSdk": ">=0.6.79"
  },
  "alia": {
    "name": "Archive Section",
    "description": "Moves a thread into your Archived sidebar section the moment you archive it, and restores its old section when you unarchive it.",
    "branding": {
      "icon": "Archive"
    },
    "server": "./server.ts"
  },
  "files": [
    "dist/",
    "skills/",
    "server.ts",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "env -u ALIA_CLI alia plugin build .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "hono": "^4.13.13",
    "typescript": "^5.7.0"
  },
  "author": "Nikos Benakis",
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.79"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/archive-section#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/archive-section"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
