{
  "name": "alia-plugin-ocean-dark",
  "version": "0.1.0",
  "description": "An Ocean-inspired dark theme for VesnALIA with blue-grey surfaces, sky-blue accents, and matching code and terminal colours.",
  "type": "module",
  "license": "MIT",
  "author": "Treo-Solutions",
  "engines": {
    "alia": ">=0.47.1 <1.0.0",
    "aliaPluginSdk": ">=0.6.79 <0.7.0"
  },
  "files": [
    "server.ts",
    "dist/",
    "themes/",
    "assets/",
    "screenshots/",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "alia plugin build",
    "typecheck": "tsc --noEmit"
  },
  "alia": {
    "name": "Ocean Dark",
    "description": "Give VesnALIA blue-grey surfaces, sky-blue accents, and teal highlights, with matching code, diff, and terminal colours. Adapts T3 Code's Ocean dark palette and stays dark in either appearance mode.",
    "branding": {
      "icon": "./assets/ocean.svg"
    },
    "server": "./server.ts",
    "skills": [],
    "themes": [
      {
        "id": "ocean-dark",
        "name": "Ocean Dark",
        "description": "Blue-grey surfaces with sky-blue and teal accents. Adapted from T3 Code's Ocean dark palette.",
        "css": "./themes/ocean-dark.css",
        "codeTheme": {
          "dark": "./themes/ocean-dark.json",
          "light": "./themes/ocean-dark.json"
        }
      }
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.79"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/ocean-dark#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/ocean-dark"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
