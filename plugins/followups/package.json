{
  "name": "alia-plugin-followups",
  "version": "0.6.6",
  "description": "Suggest clickable follow-up prompts above the composer when a thread finishes.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:worker-prompts": "node --test --test-name-pattern=\"worker sessions are told|worker session rules|pipeline returns literal worker text|drafting-only rules|detailed prompt asks\" tests/robustness.test.mjs",
    "eval:followups": "node scripts/eval-followups.mjs",
    "build": "alia plugin build",
    "dev": "alia plugin dev"
  },
  "engines": {
    "alia": ">=0.45",
    "aliaPluginSdk": ">=0.6.15"
  },
  "alia": {
    "name": "Followups",
    "description": "Suggest clickable follow-up prompts above the composer when a thread finishes.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.6.15"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/followups#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/followups"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
