{
  "name": "alia-plugin-e-corp",
  "version": "0.1.1",
  "type": "module",
  "description": "A cold corporate workstation theme for VesnALIA.",
  "license": "MIT",
  "keywords": [
    "alia-plugin",
    "alia-theme",
    "theme",
    "dark-theme",
    "light-theme"
  ],
  "scripts": {
    "build:theme": "./source/build.sh",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:theme && alia plugin build",
    "check": "npm run build:theme && alia plugin types --check && npm run typecheck && alia plugin build"
  },
  "engines": {
    "alia": ">=0.42",
    "aliaPluginSdk": ">=0.4.47"
  },
  "alia": {
    "name": "E Corp",
    "description": "Adds a cold corporate workstation palette with matching code, diff, file-tree, and terminal colors.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "skills": [],
    "themes": [
      {
        "id": "e-corp",
        "name": "E Corp",
        "description": "Petroleum blue surfaces, restrained cyan illumination, steel dividers, and matching syntax colors.",
        "css": "./themes/e-corp.css",
        "codeTheme": {
          "dark": "./themes/pierre-dark.json",
          "light": "./themes/pierre-light.json"
        }
      }
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@vesnalia/plugin-sdk": ">=0.4.47"
  },
  "peerDependenciesMeta": {
    "@vesnalia/plugin-sdk": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/e-corp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vesnalia/vesnalia-plugins.git",
    "directory": "plugins/e-corp"
  },
  "bugs": {
    "url": "https://github.com/Vesnalia/vesnalia-plugins/issues"
  }
}
