{
  "name": "alia-plugin-antigravity-cli",
  "version": "0.1.7",
  "type": "module",
  "license": "MIT",
  "description": "Use the installed Antigravity CLI as an ACP agent in VesnALIA.",
  "files": [
    "server.ts",
    "host.ts",
    "cli.ts",
    "background-tasks.ts",
    "subagents.ts",
    "dialect.ts",
    "prompt-mode.ts",
    "mode-controls.ts",
    "usage.ts",
    "dist/*.js",
    "dist/*.css",
    "dist/*.meta.json",
    "!dist/*.map",
    "README.md",
    "LICENSE",
    "PLUGIN_OVERVIEW.md",
    "SECURITY.md",
    "docs",
    "assets",
    "skills"
  ],
  "engines": {
    "alia": ">=0.48",
    "aliaPluginSdk": ">=0.6.104 <0.7",
    "node": ">=22"
  },
  "alia": {
    "name": "Antigravity CLI [Experimental]",
    "description": "Chat with Antigravity in VesnALIA using your installed CLI and existing sign-in.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "scripts": {
    "build": "alia plugin build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@vesnalia/plugin-sdk": "^0.6.125"
  },
  "homepage": "https://github.com/Vesnalia/vesnalia-plugins/tree/main/plugins/antigravity-cli#readme",
  "repository": {
